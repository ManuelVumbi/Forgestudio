# GEMINI_API_KEY: Required for optional AI features if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BUILD_ENCRYPTION_KEY: 32-byte hex or passphrase for encrypting Keystores and build credentials at rest.
BUILD_ENCRYPTION_KEY="change-me-in-production"

# ANDROID_WORKER_URL: Optional remote Docker/Linux worker endpoint with Android SDK + Gradle.
ANDROID_WORKER_URL=""
ANDROID_WORKER_TOKEN=""

# WINDOWS_WORKER_URL: Optional remote Windows/Wine+NSIS+Electron-Builder worker endpoint.
WINDOWS_WORKER_URL=""
WINDOWS_WORKER_TOKEN=""
